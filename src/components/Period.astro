---
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import { formatPeriod } from "@/utils/formatPeriod";
import { toLocale } from "@/utils/locales";
import { useTranslations } from "@/i18n";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  start: Date;
  end?: Date | null;
  company?: string;
};

const { start, end, company, size = "sm", class: className = "" } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const range = formatPeriod({ start, end }, locale, t.post.present);
const text = company ? `${range} · ${company}` : range;
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
    {text}
  </span>
</div>
