---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import { useTranslations } from "@/i18n";
import type { OpenSourceItem } from "@/utils/getOpenSourceItems";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3" | "h4";
} & Omit<OpenSourceItem, "createdAt">;

const {
  variant: Heading = "h2",
  id,
  url,
  title,
  description,
  stars,
  forks,
  tags,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const starCount =
  stars === null
    ? null
    : new Intl.NumberFormat(locale, { notation: "compact" }).format(stars);
// Hidden rather than shown as 0 when nobody has forked the repo.
const forkCount = forks
  ? new Intl.NumberFormat(locale, { notation: "compact" }).format(forks)
  : null;
---

<li class="my-6">
  <div class="flex flex-wrap items-center gap-x-3">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        "text-accent inline-block text-lg font-medium",
        "decoration-dashed underline-offset-4 hover:underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      <Heading transition:name={toTransitionName(`repo-${id}`)}>
        {title}
      </Heading>
    </a>
    {
      starCount !== null && (
        <span
          class="flex items-center gap-x-1 opacity-80"
          title={t.openSource.stars}
          aria-label={`${t.openSource.stars}: ${starCount}`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
          </svg>
          {starCount}
        </span>
      )
    }
    {
      forkCount !== null && (
        <span
          class="flex items-center gap-x-1 opacity-80"
          title={t.openSource.forks}
          aria-label={`${t.openSource.forks}: ${forkCount}`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" />
          </svg>
          {forkCount}
        </span>
      )
    }
  </div>
  {description && <p>{description}</p>}
  {
    tags.length > 0 && (
      <ul class="mt-1 flex flex-wrap gap-x-3 gap-y-1">
        {tags.map(tag => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}/`)}
              class:list={[
                "flex items-center gap-0.5 text-sm",
                "border-foreground border-b-2 border-dashed",
                "hover:border-accent hover:text-accent",
                "focus-visible:text-accent focus-visible:border-none",
              ]}
            >
              <IconHash class="size-4 opacity-80" />
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</li>
