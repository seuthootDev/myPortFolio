---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import profile from "@/assets/images/profile.jpg";
import { DEFAULT_LOCALE, toLocale } from "@/utils/locales";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = toLocale(Astro.currentLocale ?? config.site.lang);
const t = useTranslations(locale);

// `src/content/pages/<locale>/about.md`, falling back to the default locale.
const about =
  (await getEntry("pages", `${locale}/about`)) ??
  (await getEntry("pages", `${DEFAULT_LOCALE}/about`));

if (!about) {
  throw new Error(
    `Missing content entry: \`about.md\` in \`src/content/pages/${DEFAULT_LOCALE}/\``
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Image
      src={profile}
      alt={t.about.photoAlt}
      width={160}
      height={160}
      class="not-prose mx-0! mb-6 size-32 rounded-full border-0! object-cover"
    />
    <Content />
  </Main>

  <Footer />
</Layout>
