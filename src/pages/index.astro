---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import IconRss from "@/assets/icons/IconRss.svg";
import profile from "@/assets/images/profile.jpg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import RepoCard from "@/components/RepoCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getLocalizedPosts } from "@/utils/getLocalizedPosts";
import { getOpenSourceItems } from "@/utils/getOpenSourceItems";
import { toLocale } from "@/utils/locales";
import { CATEGORIES } from "@/utils/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getLocalizedPosts(toLocale(locale));
const sortedPosts = getSortedPosts(posts);
const repos = await getOpenSourceItems();
const sections = CATEGORIES.map(({ id, kind, showRecentHeading }) => ({
  id,
  kind,
  label: t.categories[id].label,
  showRecentHeading,
  posts:
    kind === "posts"
      ? sortedPosts
          .filter(({ data }) => data.category === id)
          .slice(0, postsConfig.perIndex)
      : [],
  repos: kind === "repos" ? repos.slice(0, postsConfig.perIndex) : [],
}));
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {t.home.greeting}
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <div class="flex items-center gap-4 max-sm:flex-col max-sm:items-start">
        <Image
          src={profile}
          alt={t.about.photoAlt}
          width={192}
          height={192}
          class="size-24 shrink-0 rounded-full object-cover"
        />
        <p>{t.home.intro}</p>
      </div>
      <p class="mt-2">
        {t.home.explore}{" "}
        {
          sections.map(({ id, label }, i) => (
            <>
              {i > 0 && " · "}
              <LinkButton
                class="hover:text-accent underline decoration-dashed underline-offset-4"
                href={`#${id}`}
              >
                {label}
              </LinkButton>
            </>
          ))
        }
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      sections.map(({ id, label, showRecentHeading, posts, repos }) => (
        <section id={id} class="border-border border-b pt-12 pb-6">
          <h2 class="text-3xl font-bold tracking-wide">{label}</h2>
          {posts.length + repos.length === 0 && (
            <p class="text-muted-foreground mt-4">{t.home.empty}</p>
          )}
          {posts.length + repos.length > 0 && (
            <div id={`${id}-recent`} class="mt-6">
              {showRecentHeading && (
                <h3 class="text-xl font-semibold tracking-wide">
                  {t.home.recentPrefix} {label}
                </h3>
              )}
              <ul>
                {posts.map(data => (
                  <Card variant={showRecentHeading ? "h4" : "h3"} {...data} />
                ))}
                {repos.map(repo => (
                  <RepoCard
                    variant={showRecentHeading ? "h4" : "h3"}
                    {...repo}
                  />
                ))}
              </ul>
            </div>
          )}
          <div class="mt-6 text-center">
            <LinkButton href={getRelativeLocaleUrl(locale, id)}>
              {`${t.home.allPrefix} ${label}`}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      ))
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
