---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import RepoCard from "@/components/RepoCard.astro";
import Footer from "@/components/Footer.astro";
import { getOpenSourceItems } from "@/utils/getOpenSourceItems";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const { label, desc } = t.categories["open-source"];

const items = await getOpenSourceItems();
---

<Layout title={`${label} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={label} pageDesc={desc}>
    {
      items.length === 0 ? (
        <p class="text-muted-foreground">{t.home.empty}</p>
      ) : (
        <ul>
          {items.map(item => (
            <RepoCard {...item} />
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
