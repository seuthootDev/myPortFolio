---
// Private PDF builder: pick projects / open source entries, then print the
// page to PDF. Not linked from the menu and kept out of search engines.
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getLocalizedPosts } from "@/utils/getLocalizedPosts";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getOpenSourceItems } from "@/utils/getOpenSourceItems";
import { formatPeriod } from "@/utils/formatPeriod";
import { toLocale } from "@/utils/locales";
import { RESUME_URL } from "@/utils/links";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const loc = toLocale(locale);
const t = useTranslations(locale);

// What is ticked by default: the same entries the home page shows.
const { perIndex } = config.posts;

const posts = getSortedPosts(
  await getLocalizedPosts(loc, ({ data }) => !data.draft)
);
const repos = await getOpenSourceItems();

// PDF links must be absolute to work outside the site.
const origin = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path, origin).href;
const shortUrl = (url: string) =>
  url.replace(/^(https?:\/\/|mailto:)/, "").replace(/\/$/, "");

const monthYear = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "short",
});

const projectItems = await Promise.all(
  posts.map(async (post, index) => {
    const { data } = post;
    const meta = data.period
      ? [formatPeriod(data.period, loc, t.post.present), data.company]
          .filter(Boolean)
          .join(" · ")
      : monthYear.format(data.pubDatetime);
    // The full write-up, printed after the overview.
    const { Content } = await render(post);
    return {
      key: `p.${post.id.split("/").pop()}`,
      title: data.title,
      meta,
      description: data.description,
      tags: data.tags,
      image:
        data.mainImage ??
        (typeof data.ogImage === "string" ? data.ogImage : undefined),
      url: absolute(getPostUrl(post.id, post.filePath, locale)),
      isDefault: index < perIndex,
      Content,
    };
  })
);

const repoItems = repos.map((repo, index) => ({
  key: `o.${repo.id}`,
  title: repo.title,
  description: repo.description,
  tags: repo.tags,
  stars: repo.stars,
  url: repo.url,
  isDefault: index < perIndex,
}));

const socialLabels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
  x: "X",
  mail: "Email",
};
const contacts = [
  // This portfolio itself, so a printed copy points back to the live site.
  {
    label: t.portfolio.website,
    href: config.site.url,
    text: shortUrl(config.site.url),
  },
  ...config.socials.map(({ name, url }) => ({
    label: socialLabels[name] ?? name,
    href: url,
    text: shortUrl(url),
  })),
  { label: t.portfolio.resume, href: RESUME_URL, text: shortUrl(RESUME_URL) },
];

const buttonClass =
  "border-border hover:text-accent rounded border px-3 py-1 text-sm font-medium";
---

<Layout title={`${t.portfolio.title} | ${config.site.title}`} noindex>
  <Header />

  <main
    id="pf-root"
    class="app-layout pb-10"
    data-gif-note={t.portfolio.gifNote}
  >
    <section class="print:hidden">
      <h1 class="mt-8 text-2xl font-semibold sm:text-3xl">
        {t.portfolio.title}
      </h1>
      <p class="mt-2 mb-6 italic">{t.portfolio.desc}</p>

      <div class="space-y-4">
        <fieldset>
          <legend class="font-semibold">{t.categories.projects.label}</legend>
          {
            projectItems.map(item => (
              <label class="mt-1 flex items-center gap-2">
                <input
                  type="checkbox"
                  class="accent-accent"
                  data-key={item.key}
                  data-default={item.isDefault}
                />
                <span>{item.title}</span>
              </label>
            ))
          }
        </fieldset>

        <fieldset>
          <legend class="font-semibold">
            {t.categories["open-source"].label}
          </legend>
          {
            repoItems.map(item => (
              <label class="mt-1 flex items-center gap-2">
                <input
                  type="checkbox"
                  class="accent-accent"
                  data-key={item.key}
                  data-default={item.isDefault}
                />
                <span>{item.title}</span>
              </label>
            ))
          }
        </fieldset>

        <fieldset>
          <legend class="font-semibold">{t.portfolio.include}</legend>
          <label class="mt-1 flex items-center gap-2">
            <input
              id="opt-intro"
              type="checkbox"
              class="accent-accent"
              checked
            />
            <span>{t.portfolio.intro}</span>
          </label>
          <label class="mt-1 flex items-center gap-2">
            <input
              id="opt-images"
              type="checkbox"
              class="accent-accent"
              checked
            />
            <span>{t.portfolio.images}</span>
          </label>
          <label class="mt-1 flex items-center gap-2">
            <input
              id="opt-details"
              type="checkbox"
              class="accent-accent"
              checked
            />
            <span>{t.portfolio.details}</span>
          </label>
        </fieldset>

        <div class="flex flex-wrap gap-3">
          <button
            id="pf-save"
            type="button"
            class={buttonClass}
            data-preparing={t.portfolio.preparing}
          >
            {t.portfolio.save}
          </button>
          <button id="pf-reset" type="button" class={buttonClass}>
            {t.portfolio.reset}
          </button>
        </div>
        <p class="text-muted-foreground text-sm">{t.portfolio.note}</p>
      </div>
    </section>

    <article
      id="pf-doc"
      class="border-border mt-8 rounded-lg border p-6 print:mt-0 print:rounded-none print:border-0 print:p-0"
    >
      <div id="pf-intro">
        <p class="text-2xl font-bold">{t.portfolio.name}</p>
        <p class="mt-2">{t.home.intro}</p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {
            contacts.map(({ label, href, text }) => (
              <li>
                <span class="font-medium">{`${label}:`}</span>{" "}
                <a href={href} class="text-accent">
                  {text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <section data-section="projects" class="mt-8">
        <h2 class="border-border border-b pb-1 text-xl font-bold">
          {t.categories.projects.label}
        </h2>
        {
          projectItems.map(item => (
            <div data-item data-key={item.key} class="mt-5 break-inside-avoid">
              <h3 class="text-lg font-semibold">
                <a href={item.url} class="text-accent">
                  {item.title}
                </a>
              </h3>
              <p class="text-muted-foreground text-sm">{item.meta}</p>
              <p class="mt-1">{item.description}</p>
              {item.tags.length > 0 && (
                <p class="text-sm">
                  {item.tags.map(tag => `#${tag}`).join("  ")}
                </p>
              )}
              {item.image && (
                <img
                  src={item.image}
                  alt={item.title}
                  loading="eager"
                  class="pf-img border-border mt-3 max-h-64 w-full rounded border object-contain"
                />
              )}
            </div>
          ))
        }
      </section>

      <section data-section="open-source" class="mt-8">
        <h2 class="border-border border-b pb-1 text-xl font-bold">
          {t.categories["open-source"].label}
        </h2>
        {
          repoItems.map(item => (
            <div data-item data-key={item.key} class="mt-5 break-inside-avoid">
              <h3 class="text-lg font-semibold">
                <a href={item.url} class="text-accent">
                  {item.title}
                </a>
                {item.stars !== null && (
                  <span class="text-muted-foreground ms-2 text-sm font-normal">
                    {`★ ${item.stars}`}
                  </span>
                )}
              </h3>
              <p class="text-muted-foreground text-sm">{shortUrl(item.url)}</p>
              {item.description && <p class="mt-1">{item.description}</p>}
              {item.tags.length > 0 && (
                <p class="text-sm">
                  {item.tags.map(tag => `#${tag}`).join("  ")}
                </p>
              )}
            </div>
          ))
        }
      </section>

      <p id="pf-empty" class="text-muted-foreground mt-8" hidden>
        {t.portfolio.nothing}
      </p>

      <div id="pf-details">
        {
          projectItems.map(item => {
            const Content = item.Content;
            return (
              <section
                data-detail
                data-key={item.key}
                data-url={item.url}
                class="pf-detail border-border mt-10 border-t pt-6 print:mt-0 print:border-0 print:pt-0"
              >
                <h2 class="text-2xl font-bold">
                  <a href={item.url} class="text-accent">
                    {item.title}
                  </a>
                </h2>
                <p class="text-muted-foreground text-sm">{item.meta}</p>
                <div class="app-prose mt-4 max-w-none">
                  <Content />
                </div>
              </section>
            );
          })
        }
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Three stills standing in for a GIF, plus a link to the animated original. */
  .pf-frames {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin: 1.25em 0 0.25em;
    break-inside: avoid;
  }

  .pf-frames img {
    margin: 0 !important;
    width: 100%;
    height: auto;
  }

  .pf-frames-note {
    display: block;
    margin-bottom: 1.25em;
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }

  @media print {
    @page {
      size: A4;
      margin: 14mm;
    }

    /* Always print on white, whatever theme the page is in. */
    :root[data-theme="dark"] {
      --background: #fdfdfd;
      --foreground: #282728;
      --accent: #006cac;
      --accent-foreground: #ffffff;
      --muted: #e6e6e6;
      --muted-foreground: #6b7280;
      --border: #ece9e9;
    }

    html,
    body {
      background: #fff !important;
    }

    body > header,
    body > footer,
    body > #skip-to-content {
      display: none !important;
    }

    /* Each project's write-up starts on its own page, after the overview. */
    .pf-detail {
      break-before: page;
    }

    .pf-detail h2,
    .pf-detail h3,
    .pf-detail h4 {
      break-after: avoid;
    }

    .pf-detail img,
    .pf-detail table,
    .pf-detail pre {
      break-inside: avoid;
    }

    .pf-detail img {
      max-height: 90mm;
      width: auto;
      max-width: 100%;
    }

    /* Keep a caption line together with the picture that follows it. */
    .pf-detail p:has(+ p > img:only-child),
    .pf-detail p:has(+ p > .pf-frames) {
      break-after: avoid;
    }

    /* The stills share the row, so they must not be shrunk like single images. */
    .pf-detail .pf-frames img {
      width: 100%;
      max-height: none;
    }

    /* Code blocks: light colors even when the page is in dark mode. */
    html[data-theme="dark"] .pf-detail .astro-code {
      background-color: var(--shiki-light-bg) !important;
    }

    html[data-theme="dark"] .pf-detail .astro-code span {
      color: var(--shiki-light) !important;
    }
  }
</style>

<script>
  type State = {
    keys: string[];
    intro: boolean;
    images: boolean;
    details: boolean;
  };

  const STORAGE_KEY = "portfolio-pdf-selection";

  // The selection lives in the URL (?sel=p.das3d,o.repo&intro=0&img=0&det=0)
  // so a link reproduces it, and in localStorage so the last choice is kept.
  function readUrl(): State | null {
    const params = new URLSearchParams(location.search);
    if (!params.has("sel")) return null;
    return {
      keys: (params.get("sel") ?? "").split(",").filter(Boolean),
      intro: params.get("intro") !== "0",
      images: params.get("img") !== "0",
      details: params.get("det") !== "0",
    };
  }

  function readStorage(): State | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as State) : null;
    } catch {
      return null;
    }
  }

  function save(state: State) {
    const params = new URLSearchParams({ sel: state.keys.join(",") });
    if (!state.intro) params.set("intro", "0");
    if (!state.images) params.set("img", "0");
    if (!state.details) params.set("det", "0");
    history.replaceState(history.state, "", `${location.pathname}?${params}`);
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      // Storage can be unavailable (private mode); the URL still works.
    }
  }

  // A GIF can't move in a PDF, so it is replaced by three stills taken from
  // the start, middle and end of the animation, with a note linking to the
  // original on the web. Uses the browser's ImageDecoder (Chrome / Edge);
  // elsewhere the GIF is left alone and prints as its first frame.
  type Decoder = {
    tracks: { ready: Promise<void>; selectedTrack: { frameCount: number } };
    decode(options: {
      frameIndex: number;
      completeFramesOnly: boolean;
    }): Promise<{
      image: CanvasImageSource & {
        displayWidth: number;
        displayHeight: number;
        close(): void;
      };
    }>;
    close(): void;
  };

  async function splitGif(img: HTMLImageElement, note: string) {
    const ImageDecoder = (
      window as unknown as {
        ImageDecoder?: new (init: {
          data: ArrayBuffer;
          type: string;
        }) => Decoder;
      }
    ).ImageDecoder;
    if (!ImageDecoder) return;

    const data = await (await fetch(img.src)).arrayBuffer();
    const decoder = new ImageDecoder({ data, type: "image/gif" });
    await decoder.tracks.ready;
    const count = decoder.tracks.selectedTrack.frameCount;
    const indexes = [
      ...new Set([0.1, 0.5, 0.9].map(p => Math.round(p * (count - 1)))),
    ];

    const wrap = document.createElement("div");
    wrap.className = "pf-frames";
    for (const frameIndex of indexes) {
      const { image } = await decoder.decode({
        frameIndex,
        completeFramesOnly: true,
      });
      const canvas = document.createElement("canvas");
      canvas.width = image.displayWidth;
      canvas.height = image.displayHeight;
      canvas.getContext("2d")!.drawImage(image, 0, 0);
      image.close();

      const frame = document.createElement("img");
      frame.src = canvas.toDataURL("image/jpeg", 0.85);
      frame.alt = img.alt;
      wrap.append(frame);
    }
    decoder.close();

    const url = img.closest<HTMLElement>("[data-url]")?.dataset.url;
    const caption = document.createElement(url ? "a" : "p");
    caption.className = "pf-frames-note";
    caption.textContent = note;
    if (url) (caption as HTMLAnchorElement).href = url;

    img.replaceWith(wrap, caption);
  }

  function init() {
    const root = document.querySelector<HTMLElement>("#pf-root");
    if (!root) return;

    const boxes = [
      ...root.querySelectorAll<HTMLInputElement>("input[data-key]"),
    ];
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const sections = [...root.querySelectorAll<HTMLElement>("[data-section]")];
    const images = [...root.querySelectorAll<HTMLElement>(".pf-img")];
    const details = [...root.querySelectorAll<HTMLElement>("[data-detail]")];
    const intro = root.querySelector<HTMLElement>("#pf-intro")!;
    const empty = root.querySelector<HTMLElement>("#pf-empty")!;
    const introBox = root.querySelector<HTMLInputElement>("#opt-intro")!;
    const imagesBox = root.querySelector<HTMLInputElement>("#opt-images")!;
    const detailsBox = root.querySelector<HTMLInputElement>("#opt-details")!;

    // A video can't play in a PDF: show its poster image instead.
    root
      .querySelectorAll<HTMLVideoElement>(".pf-detail video")
      .forEach(video => {
        if (!video.poster) return video.remove();
        const poster = document.createElement("img");
        poster.src = video.poster;
        poster.alt = "";
        video.replaceWith(poster);
      });

    const defaults: State = {
      keys: boxes
        .filter(box => box.dataset.default === "true")
        .map(box => box.dataset.key!),
      intro: true,
      images: true,
      details: true,
    };

    const read = (): State => ({
      keys: boxes.filter(box => box.checked).map(box => box.dataset.key!),
      intro: introBox.checked,
      images: imagesBox.checked,
      details: detailsBox.checked,
    });

    // Reflect a state in the checkboxes and the preview.
    const render = (state: State) => {
      const selected = new Set(state.keys);
      // A selection saved before this option existed has no `details`.
      const showDetails = state.details !== false;
      boxes.forEach(box => (box.checked = selected.has(box.dataset.key!)));
      introBox.checked = state.intro;
      imagesBox.checked = state.images;
      detailsBox.checked = showDetails;
      details.forEach(
        detail =>
          (detail.hidden = !showDetails || !selected.has(detail.dataset.key!))
      );

      items.forEach(item => (item.hidden = !selected.has(item.dataset.key!)));
      sections.forEach(
        section =>
          (section.hidden = !section.querySelector("[data-item]:not([hidden])"))
      );
      intro.hidden = !state.intro;
      images.forEach(image => (image.hidden = !state.images));
      empty.hidden = state.intro || items.some(item => !item.hidden);
    };

    // Split the GIFs of the projects that are showing, once each.
    const gifs = [
      ...root.querySelectorAll<HTMLImageElement>(".pf-detail img"),
    ].filter(img => /\.gif(\?|$)/i.test(img.src));
    const gifJobs = new Map<HTMLImageElement, Promise<void>>();
    const prepareGifs = () =>
      Promise.all(
        gifs
          .filter(img => !img.closest("[hidden]"))
          .map(img => {
            if (!gifJobs.has(img)) {
              gifJobs.set(
                img,
                splitGif(img, root.dataset.gifNote ?? "").catch(() => {})
              );
            }
            return gifJobs.get(img)!;
          })
      );

    const initial = readUrl() ?? readStorage();
    render(initial ?? defaults);
    if (initial) save(read());
    void prepareGifs();

    root.addEventListener("change", event => {
      if ((event.target as HTMLElement).tagName !== "INPUT") return;
      const state = read();
      render(state);
      save(state);
      void prepareGifs();
    });

    root.querySelector("#pf-reset")?.addEventListener("click", () => {
      render(defaults);
      void prepareGifs();
      history.replaceState(history.state, "", location.pathname);
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {
        // ignore
      }
    });

    const saveButton = root.querySelector<HTMLButtonElement>("#pf-save");
    saveButton?.addEventListener("click", async () => {
      // Make sure every GIF has been turned into stills before printing.
      const label = saveButton.textContent;
      saveButton.disabled = true;
      saveButton.textContent = saveButton.dataset.preparing ?? label;
      await prepareGifs();
      saveButton.disabled = false;
      saveButton.textContent = label;
      window.print();
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
