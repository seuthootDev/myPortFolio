---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getLocalizedPosts } from "@/utils/getLocalizedPosts";
import { getOpenSourceItems } from "@/utils/getOpenSourceItems";
import { toLocale } from "@/utils/locales";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getLocalizedPosts(
  toLocale(locale),
  ({ data }) => !data.draft
);
const repos = await getOpenSourceItems();
const tags = getUniqueTags(
  posts,
  repos.flatMap(repo => repo.tags)
);
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
